							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						},
						"description": "CU05 flujo principal. Usa las variables email y password de la colección."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('responde con 200', function () { pm.response.to.have.status(200); });",
									"const respuesta = pm.response.json();",
									"pm.test('devuelve token y usuario', function () {",
									"  pm.expect(respuesta.token).to.be.a('string');",
									"  pm.expect(respuesta.usuario).to.have.property('rol');",
									"  pm.expect(respuesta.usuario).to.not.have.property('passwordHash');",
									"});",
									"// Se guarda el token para las rutas protegidas (/me, /logout)",
									"pm.collectionVariables.set('jwt_token', respuesta.token);"
								]
							}
						}
					]
